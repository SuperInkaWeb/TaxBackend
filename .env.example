# ─── App ───────────────────────────────────────────────────────────────────────
APP_NAME="SIRE Bot"
APP_ENV=development          # development | production
SECRET_KEY=changeme-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# ─── Encryption (AES-256 para clave SOL y client_secret) ────────────────────
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-generate-a-fernet-key

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sire_bot

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local        # local | r2
STORAGE_LOCAL_PATH=./storage

# Cloudflare R2 (solo si STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sire-reportes

# ─── Email (notificaciones aprobación/rechazo) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@tudominio.com

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# Credenciales SUNAT solo para scripts/test_propuesta.py (opcional, dev)
TEST_SUNAT_RUC=
TEST_SUNAT_USUARIO=
TEST_SUNAT_CLAVE=
TEST_SUNAT_CLIENT_ID=
TEST_SUNAT_CLIENT_SECRET=
